# Credenciales de la API PISTE (Légifrance) - https://piste.gouv.fr
# Copia este archivo a `.env` (mismo directorio) y rellena tus valores.
# `.env` está en .gitignore: NO se sube al repo.
#
# Cómo obtenerlas:
#   1. Crear cuenta en https://piste.gouv.fr/registration
#   2. En "API > Consentement CGU API" aceptar las CGU de Légifrance
#   3. En "Applications" crear una nueva app y vincularla a la API "Légifrance" (PROD)
#   4. Generar credenciales OAuth y copiar abajo.

PISTE_CLIENT_ID=pon_aqui_tu_client_id
PISTE_CLIENT_SECRET=pon_aqui_tu_client_secret
