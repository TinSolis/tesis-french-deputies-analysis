# Capturas Zeeschuimer: suelen superar el límite de 100 MB de GitHub
french_deputies/zeeschuimer/captures/*.ndjson

# Datos masivos (descargar de nuevo con los scripts si hace falta)
french_deputies/datos_diputados/data/*.zip
french_deputies/lois_votes/votes_rd/*.json.zip
french_deputies/lois_votes/votes_rd/json/
